# muse-run settings — copy to ~/.config/muse-run/env (install.sh does this if the file is missing).
# Plain shell: sourced by muse-run on every call. Everything is optional; unset = default.
# Check what is in effect with:  muse-run --env

# Model opencode runs. The Zen "contributor-free" Muse needs no API key or login (verified 2026-09-05).
#MUSE_MODEL=opencode/muse-spark-1.3-contributor-free

# Foreground wait before muse-run prints "MUSE-RUN PENDING <id>" and exits 3.
# Keep under Claude Code's 600 s Bash cap; the relay agent loops --wait.
#MUSE_WAIT=540

# Hard wall per job, seconds. The job is killed after this.
#MUSE_MAX=3600

# ---- start gate: how many opencode processes may run at once ----------------------
# A job starts only while running < MUSE_MAX_JOBS AND
#   available_memory_MB - MUSE_MEM_RESERVE_MB >= MUSE_JOB_MB.
# One opencode run is 580-900 MB RSS. Pick a profile and uncomment it.

# Profile: small VPS, 4 cores / 8 GB (Sleeper). Measured 2026-09-05: 3 jobs with a 2.5 GB
# service resident, 4-5 when the box is idle. The memory gate does the real limiting.
#MUSE_MAX_JOBS=6
#MUSE_JOB_MB=800
#MUSE_MEM_RESERVE_MB=1024

# Profile: laptop, 16 GB. Reserve more so the desktop stays usable.
#MUSE_MAX_JOBS=8
#MUSE_JOB_MB=900
#MUSE_MEM_RESERVE_MB=4096

# Profile: laptop, 36 GB (Petter's MacBook, 12 cores). opencode is network-bound, so jobs beyond
# the core count are fine; the Zen rate limit and the memory gate limit before CPU does. macOS
# "available" = free+inactive+speculative (conservative), so 4 GB reserve keeps the desktop usable.
#MUSE_MAX_JOBS=16
#MUSE_JOB_MB=900
#MUSE_MEM_RESERVE_MB=4096

# Profile: workstation, 32 GB+. The Zen free tier's rate limit will bite before RAM does.
#MUSE_MAX_JOBS=12
#MUSE_JOB_MB=900
#MUSE_MEM_RESERVE_MB=6144

# How long --start polls for a free slot before giving up with exit 4.
#MUSE_START_WAIT=300

# ---- paths and binaries -----------------------------------------------------------
# Where job directories live (task, out.json, err, rc, pid, meta). Pruned after 2 days.
#MUSE_JOBS=~/.cache/muse-run/jobs

# opencode binary, if not on PATH for the detached job (e.g. a Homebrew or npm-global path).
#MUSE_OPENCODE=/opt/homebrew/bin/opencode

# Opt-in: attach to a persistent `opencode serve` instead of one process per job.
# Hung 6 of 7 short runs with opencode 1.18.27 (2026-09-05); leave unset unless you retest.
#MUSE_SERVER=http://127.0.0.1:4096
